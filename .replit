run = "bash start.sh"
entrypoint = "start.sh"
modules = ["nodejs-20", "python-3.11"]

[env]
PORT = "8080"

[deployment]
run = ["bash", "-c", "cd backend && uv run uvicorn main:app --host 0.0.0.0 --port 8080"]
build = ["bash", "-c", "cd frontend && npm install && npm run build && mkdir -p ../backend/frontend && cp -r dist ../backend/frontend/ && cd ../backend && uv sync"]
deploymentTarget = "vm"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 bash start.sh"
waitForPort = 5000

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
