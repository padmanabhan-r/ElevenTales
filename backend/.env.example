# ElevenLabs API Keys
# Get yours at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional backup key — used automatically if primary hits quota/rate limits
ELEVENLABS_API_KEY_BACKUP=

# Google Gemini API Key (used for image generation + content moderation)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Image generation model
IMAGE_MODEL=gemini-3.1-flash-image-preview
